{"nodes": [{"id": "obsidian_vault_evaluation_integrator", "label": "Integrator (Naeherungsverfahren)", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/Integrator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "obsidian_vault_evaluation_integrator_anfangswertproblem", "label": "Anfangswertproblem", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/Integrator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "obsidian_vault_evaluation_integrator_energieerhaltung", "label": "Energieerhaltung als Pruefgroesse", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/Integrator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "obsidian_vault_evaluation_integrator_euler", "label": "Euler-Verfahren", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/Integrator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verworfen: niedrigstufig, erzeugt in komplexen Systemen zu viel Energie, beruecksichtigt zu wenig Details fuer hohe Geschwindigkeiten und Anziehungskraefte."}, {"id": "obsidian_vault_evaluation_integrator_verlet", "label": "Verlet-Verfahren (symplektisch)", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/Integrator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symplektisch, Langzeitstabilitaet ohne Energiedrift; als Backup gehalten, aber verworfen weil RKN4 genug Langzeitstabilitaet bereitstellte und mehr lokale Details bietet."}, {"id": "obsidian_vault_evaluation_integrator_rk4", "label": "Runge-Kutta-4", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/Integrator.md", "source_location": null, "source_url": null, "captured_at": nu