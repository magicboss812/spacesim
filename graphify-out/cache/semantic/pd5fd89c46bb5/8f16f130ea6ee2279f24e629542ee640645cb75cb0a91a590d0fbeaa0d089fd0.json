{"nodes": [{"id": "obsidian_vault_evaluation__arbeit_01_einleitung", "label": "Einleitung (Fliesstext)", "file_type": "document", "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "obsidian_vault_evaluation__arbeit_01_einleitung_apollo_11", "label": "Apollo 11", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Juli 1969, erster Betritt eines anderen Himmelskoerpers; Flugprofil folgte einer weit ausholenden Bahn, die die Anziehung von Erde und Mond ausnutzte (bewusste Entscheidung der Missionsplanung)."}, {"id": "obsidian_vault_evaluation__arbeit_01_einleitung_voyager", "label": "Voyager-Sonden", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erreichten die aeusseren Planeten durch Gravitationsmanoever mit einem Vorrat, der fuer einen direkten Flug bei weitem nicht gereicht haette."}, {"id": "obsidian_vault_evaluation__arbeit_01_einleitung_raketengleichung", "label": "Raketengleichung (Delta-v -> Treibstoffmasse)", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die noetige Geschwindigkeitsaenderung bestimmt unmittelbar die mitzufuehrende Treibstoffmasse und damit die Startbarkeit einer Mission."}, {"id": "obsidian_vault_evaluation__arbeit_01_einleitung_flugdauer_treibstoff", "label": "Kompromiss Flugdauer vs. Treibstoffbedarf", "file_type": "rationale", "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zentraler Kompromiss der Astrodynamik: ein Transfer auf langgezogener Bahn dauert deutlich laenger als ein direkter Flug, verlangt aber ein Vielfaches weniger Geschwindigkeitsaenderung. Im Weltraum kostet der kuerzeste Weg nicht am wenigsten Treibstoff."}, {"id": "obsidian_vault_evaluation__arbeit_01_einleitung_n_body_simulation", "label": "Eigene 2D-N-Koerper-Simulation", "file_type": "concept", "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erlaubt dieselbe Mission wiederholt unter veraenderten Bedingungen (mit/ohne Vorbeiflug, unterschiedlich starke Manoever) - was Zweikoerperformeln und historische Missionsdaten nicht leisten."}], "edges": [{"source": "obsidian_vault_evaluation__arbeit_01_einleitung", "target": "obsidian_vault_evaluation__arbeit_00_gliederung__ki_ansatz__irrelevant_", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "weight": 1.0}, {"source": "obsidian_vault_evaluation__arbeit_01_einleitung", "target": "obsidian_vault_evaluation__arbeit_01_einleitung_apollo_11", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "weight": 1.0}, {"source": "obsidian_vault_evaluation__arbeit_01_einleitung", "target": "obsidian_vault_evaluation__arbeit_01_einleitung_voyager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Obsidian Vault/Evaluation/_Arbeit/01 Einleitung.md", "source_location": null, "weight": 1.0}, {"source": "obsidian_vault_evaluation__arbeit_01_einleitung", "target": "obsidian_vault_evaluation__arbeit_01_einleitung_raketengleichung", "relation": "refe